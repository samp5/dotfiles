---
Checks: >-
  -*,
  bugprone-assert-side-effect,
  bugprone-bool-pointer-implicit-conversion,
  bugprone-copy-constructor-init,
  bugprone-dangling-handle,
  bugprone-exception-escape,
  bugprone-infinite-loop,
  bugprone-integer-division,
  bugprone-misplaced-widening-cast,
  bugprone-move-forwarding-reference,
  bugprone-multiple-statement-macro,
  bugprone-narrowing-conversions,
  bugprone-not-null-terminated-result,
  bugprone-parent-virtual-call,
  bugprone-sizeof-container,
  bugprone-sizeof-expression,
  bugprone-string-constructor,
  bugprone-string-integer-assignment,
  bugprone-suspicious-memset-usage,
  bugprone-suspicious-missing-comma,
  bugprone-suspicious-string-compare,
  bugprone-swapped-arguments,
  bugprone-too-small-loop-variable,
  bugprone-undefined-memory-manipulation,
  bugprone-unhandled-self-assignment,
  bugprone-unused-raii,
  bugprone-unused-return-value,
  bugprone-use-after-move,
  bugprone-virtual-near-miss,
  cppcoreguidelines-init-variables,
  cppcoreguidelines-prefer-member-initializer,
  cppcoreguidelines-pro-type-cstyle-cast,
  cppcoreguidelines-slicing,
  modernize-loop-convert,
  modernize-make-shared,
  modernize-make-unique,
  modernize-use-auto,
  modernize-use-default-member-init,
  modernize-use-emplace,
  modernize-use-equals-delete,
  modernize-use-final,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-using,
  performance-for-range-copy,
  performance-implicit-conversion-in-loop,
  performance-move-const-arg,
  performance-move-constructor-init,
  performance-unnecessary-copy-initialization,
  performance-unnecessary-value-param,
  readability-braces-around-statements,
  readability-identifier-naming,
  readability-qualified-auto,
  readability-redundant-smartptr-get,

WarningsAsErrors: ''
HeaderFilterRegex: '.*'

CheckOptions:
  # Types (classes, structs, enums): CapsCase (PascalCase)
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.EnumCase
    value: CamelCase

  # Member variables: snake_case with trailing underscore (applies to struct and class members)
  - key: readability-identifier-naming.MemberCase
    value: lower_case
  - key: readability-identifier-naming.MemberSuffix
    value: _

  # Constants and constexprs: CAPS_UNDERSCORES (no leading k)
  - key: readability-identifier-naming.GlobalConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.StaticConstantCase
    value: UPPER_CASE

  # Enum constants: CapsCase when unscoped values, UPPER_CASE when values specified
  # clang-tidy cannot distinguish the two cases; CamelCase is used as the default
  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase

  # Namespaces: snake_case
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case

  # Template non-type (value) parameters: CAPS_UNDERSCORES (e.g. SIZE)
  - key: readability-identifier-naming.ValueTemplateParameterCase
    value: UPPER_CASE

  # Braces required even for single-line bodies
  - key: readability-braces-around-statements.ShortStatementLines
    value: '0'

  # Use auto primarily to remove stutter; require type to be long enough to be worth it
  - key: modernize-use-auto.MinTypeNameLength
    value: '5'
  - key: modernize-use-auto.RemoveStars
    value: 'false'
